    38                                  start:
    39 0000003E FA                          cli
    40 0000003F 31C0                        xor ax, ax
    41 00000041 8ED8                        mov ds, ax
    42 00000043 8EC0                        mov es, ax
    43 00000045 8ED0                        mov ss, ax
    44 00000047 BC007C                      mov sp, 0x7C00
    45 0000004A FB                          sti
    46                                  
    47 0000004B 8816[A500]                  mov [drive], dl
    48                                  
    49 0000004F FC                          cld
    50 00000050 BE[B600]                    mov si, msg_boot
    51 00000053 E83B00                      call print_string
    52                                  
    53 00000056 B441                        mov ah, 0x41                ; int 13h extensions installation check
    54 00000058 BBAA55                      mov bx, 0x55AA
    55 0000005B 8A16[A500]                  mov dl, [drive]
    56 0000005F CD13                        int 0x13
    57 00000061 721C                        jc  no_lba
    58 00000063 81FB55AA                    cmp bx, 0xAA55
    59 00000067 7516                        jne no_lba
    60                                  
    61 00000069 B442                        mov ah, 0x42                ; extended read of stage2 via the DAP
    62 0000006B 8A16[A500]                  mov dl, [drive]
    63 0000006F BE[A600]                    mov si, dap
    64 00000072 CD13                        int 0x13
    65 00000074 7211                        jc  disk_error
    66                                  
    67 00000076 8A16[A500]                  mov dl, [drive]
    68 0000007A EA007E0000                  jmp 0x0000:STAGE2_ADDR
    69                                  
    70                                  no_lba:
    71 0000007F BE[CF00]                    mov si, msg_nolba
    72 00000082 E80C00                      call print_string
    73 00000085 EB06                        jmp halt
    74                                  
    75                                  disk_error:
    76 00000087 BE[E300]                    mov si, msg_diskerr
    77 0000008A E80400                      call print_string
    78                                  
    79                                  halt:
    80 0000008D FA                          cli
    81 0000008E F4                          hlt
    82 0000008F EBFC                        jmp halt
    83                                  
