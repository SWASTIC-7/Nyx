   116                                  %ifdef FAT32
   117                                      times 0x1BE-($-$$) db 0      ; pad up to the partition table
   118                                      db 0x80, 0x00, 0x00, 0x00    ; partition 1: active, CHS start (unused)
   119                                      db 0x0C, 0x00, 0x00, 0x00    ; type 0x0C = FAT32 LBA, CHS end (unused)
   120                                      dd P1_START
   121                                      dd P1_SECTORS
   122                                      db 0x00, 0x00, 0x00, 0x00    ; partition 2: inactive
   123                                      db 0x0C, 0x00, 0x00, 0x00    ; type 0x0C = FAT32 LBA
   124                                      dd P2_START
   125                                      dd P2_SECTORS
   126                                      times 32 db 0                ; partition entries 3-4 (empty)
   127                                  %else
   128 000000F5 00<rep 109h>                times 510-($-$$) db 0
   129                                  %endif
   130 000001FE 55AA                    dw 0xAA55
