    85 00000091 50                          push ax
    86 00000092 53                          push bx
    87 00000093 56                          push si
    88 00000094 B700                        mov bh, 0
    89                                  .next:
    90 00000096 AC                          lodsb
    91 00000097 84C0                        test al, al
    92 00000099 7406                        jz .done
    93 0000009B B40E                        mov ah, 0x0E
    94 0000009D CD10                        int 0x10
    95 0000009F EBF5                        jmp .next
    96                                  .done:
