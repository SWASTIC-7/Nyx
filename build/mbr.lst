     1                                  bits 16
     2                                  org 0x7C00
     3                                  
     4                                  STAGE2_LBA     equ 1
     5                                  STAGE2_SECTORS equ 16
     6                                  STAGE2_ADDR    equ 0x7E00
     7                                  
     8                                  P1_START       equ 2048         ; partition 1 start (LBA), 40 MB
     9                                  P1_SECTORS     equ 81920
    10                                  P2_START       equ 2048 + 81920 ; partition 2 start (right after P1)
    11                                  P2_SECTORS     equ 81920
    12                                  
    13                                  %ifndef FAT32
    14 00000000 EB3C                        jmp short start
    15 00000002 90                          nop
    16                                  
    17 00000003 4E59584F53312E30        bpb_oem:                db 'NYXOS1.0'
    18 0000000B 0002                    bpb_bytes_per_sector:   dw 512
