    20 0000000E 1100                    bpb_reserved_sectors:   dw 17
    21 00000010 02                      bpb_num_fats:           db 2
    22 00000011 E000                    bpb_root_entries:       dw 224
    23 00000013 400B                    bpb_total_sectors:      dw 2880
    24 00000015 F0                      bpb_media:              db 0xF0
    25 00000016 0900                    bpb_sectors_per_fat:    dw 9
    26 00000018 0000                    bpb_sectors_per_track:  dw 0            ; CHS geometry - unused (LBA only)
    27 0000001A 0000                    bpb_heads:              dw 0            ; CHS geometry - unused (LBA only)
    28 0000001C 00000000                bpb_hidden_sectors:     dd 0
    29 00000020 00000000                bpb_large_sectors:      dd 0
    30 00000024 00                      ebr_drive:              db 0
    31 00000025 00                      ebr_reserved:           db 0
    32 00000026 29                      ebr_signature:          db 0x29
    33 00000027 78563412                ebr_volid:              dd 0x12345678
    34 0000002B 4E5958204F53202020-     ebr_vollabel:           db 'NYX OS     '
    34 00000034 2020               
    35 00000036 4641543132202020        ebr_sysid:              db 'FAT12   '
    36                                  %endif
