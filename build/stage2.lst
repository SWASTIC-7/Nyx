    49 00000B75 30C0                <1>     xor al, al
    50 00000B77 B900FA              <1>     mov cx, 64000
    51 00000B7A F3AA                <1>     rep stosb
    52 00000B7C C3                  <1>     ret
    53                              <1> 
    54                              <1> splash_logo:
    55 00000B7D B800A0              <1>     mov ax, VGA_SEG
    56 00000B80 8EC0                <1>     mov es, ax
    57 00000B82 8B36[D506]          <1>     mov si, [sel_label]            ; count characters in the chosen name
    58 00000B86 31C9                <1>     xor cx, cx
