   129                                  
   130                                  ; ---- the real -> protected mode switch --------------------------------------
   131                                  switch_to_pm:
   132 0000156B FA                          cli                                  ; real-mode IVT is about to be invalid
   133 0000156C 0F20C0                      mov eax, cr0
   134 0000156F 0C01                        or  al, 1                            ; set PE (Protection Enable)
   135 00001571 0F22C0                      mov cr0, eax
   136 00001574 EA[7915]0800                jmp CODE_SEG:pm_entry                ; far jump: reload CS=0x08, flush pipeline
   137                                  
   138                                  [bits 32]
   139                                  pm_entry:
   140 00001579 66B81000                    mov ax, DATA_SEG                     ; reload data selectors (flat data segment)
   141 0000157D 8ED8                        mov ds, ax
   142 0000157F 8EC0                        mov es, ax
   143 00001581 8EE0                        mov fs, ax
   144 00001583 8EE8                        mov gs, ax
   145 00001585 8ED0                        mov ss, ax
   146 00001587 BC00000900                  mov esp, 0x90000                     ; 32-bit stack
   147                                  
   148 0000158C BE00000100                  mov esi, KERNEL_SEG*16               ; scan the loaded kernel for the Multiboot header
   149 00001591 8B0D[CD000000]              mov ecx, [file_size]
   150 00001597 C1E902                      shr ecx, 2                           ; dwords
   151 0000159A 81F900080000                cmp ecx, 2048                        ; ...within the first 8 KB
   152 000015A0 7605                        jbe .have_len
   153 000015A2 B900080000                  mov ecx, 2048
   154                                  .have_len:
   155                                  .scan:
   156 000015A7 813E02B0AD1B                cmp dword [esi], 0x1BADB002
   157 000015AD 740B                        je .multiboot
   158 000015AF 83C604                      add esi, 4
   159 000015B2 49                          dec ecx
   160 000015B3 75F2                        jnz .scan
   161 000015B5 E9(00000100)                jmp KERNEL_SEG*16                    ; no header -> plain binary kernel (our C kernel)
   162                                  
   163                                  .multiboot:
   164 000015BA E80F000000                  call build_mb_info
   165 000015BF B802B0AD2B                  mov eax, 0x2BADB002                  ; the handoff magic
   166 000015C4 BB[68160000]                mov ebx, mb_info                     ; -> the info structure
   167 000015C9 E9(00000100)                jmp KERNEL_SEG*16
   168                                  
   169                                  ; turn the E820 map into a Multiboot info struct + mmap
   170                                  build_mb_info:
   171 000015CE BE[F2080000]                mov esi, e820_map
   172 000015D3 BF[C2160000]                mov edi, mb_mmap
   173 000015D8 0FB70D[F0080000]            movzx ecx, word [e820_count]
   174                                  .mm:
   175 000015DF C70714000000                mov dword [edi], 20                  ; size (entry bytes excluding this field)
   176 000015E5 8B06                        mov eax, [esi];    mov [edi+4],  eax ; base low
   177 000015E7 8B4604                      mov eax, [esi+4];  mov [edi+8],  eax ; base high
   178 000015EA 8B4608                      mov eax, [esi+8];  mov [edi+12], eax ; length low
   179 000015ED 8B460C                      mov eax, [esi+12]; mov [edi+16], eax ; length high
   180 000015F0 8B4610                      mov eax, [esi+16]; mov [edi+20], eax ; type
   181 000015F3 83C618                      add esi, 24
   182 000015F6 83C718                      add edi, 24
   183 000015F9 49                          dec ecx
   184 000015FA 75E3                        jnz .mm
   185                                  
   186 000015FC 0FB705[F0080000]            movzx eax, word [e820_count]
   187 00001603 6BC018                      imul eax, eax, 24
   188 00001606 A3[94160000]                mov [mb_info+44], eax                ; mmap_length
   189 0000160B C705[98160000]-             mov dword [mb_info+48], mb_mmap      ; mmap_addr
   189 00001611 [C2160000]         
   190 00001615 C705[68160000]4100-         mov dword [mb_info], 0x41            ; flags: mem (bit0) + mmap (bit6)
   190 0000161D 0000               
   191 0000161F C705[6C160000]8002-         mov dword [mb_info+4], 640           ; mem_lower (KB)
   191 00001627 0000               
   192                                  
   193 00001629 C705[70160000]0000-         mov dword [mb_info+8], 0             ; mem_upper = usable RAM at 1 MB, in KB
   193 00001631 0000               
   194 00001633 BE[F2080000]                mov esi, e820_map
   195 00001638 0FB70D[F0080000]            movzx ecx, word [e820_count]
   196                                  .mu:
   197 0000163F 813E00001000                cmp dword [esi], 0x00100000
   198 00001645 7519                        jne .mu_next
   199 00001647 837E0400                    cmp dword [esi+4], 0
   200 0000164B 7513                        jne .mu_next
   201 0000164D 837E1001                    cmp dword [esi+16], 1
   202 00001651 750D                        jne .mu_next
   203 00001653 8B4608                      mov eax, [esi+8]
   204 00001656 C1E80A                      shr eax, 10
   205 00001659 A3[70160000]                mov [mb_info+8], eax
   206 0000165E EB06                        jmp .mu_done
   207                                  .mu_next:
   208 00001660 83C618                      add esi, 24
   209 00001663 49                          dec ecx
   210 00001664 75D9                        jnz .mu
   211                                  .mu_done:
   212 00001666 C3                          ret
   213                                  
   214 00001667 90                      align 4
   215 00001668 00<rep 5Ah>             mb_info: times 90 db 0
   216 000016C2 00<rep 240h>            mb_mmap: times MAX_E820*24 db 0
