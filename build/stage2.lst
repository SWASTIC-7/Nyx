    66 00000B89 F7E1                <1>     mul cx
    67 00000B8B A3[610C]            <1>     mov [word_w], ax
    68 00000B8E BB8002              <1>     mov bx, 640                    ; centre, then byte-align the start x
    69 00000B91 29C3                <1>     sub bx, ax
    70 00000B93 D1EB                <1>     shr bx, 1
    71 00000B95 83E3F8              <1>     and bx, 0xFFF8
    72 00000B98 891E[5F0C]          <1>     mov [word_x0], bx
    73 00000B9C 891E[630C]          <1>     mov [cur_x], bx
    74 00000BA0 8B36[D506]          <1>     mov si, [sel_label]
    75                              <1> .dc:
    76 00000BA4 8A04                <1>     mov al, [si]
    77 00000BA6 84C0                <1>     test al, al
    78 00000BA8 740D                <1>     jz .done
    79 00000BAA 56                  <1>     push si
    80 00000BAB E80A00              <1>     call draw_glyph
    81 00000BAE 8306[630C]38        <1>     add word [cur_x], ADVANCE
    82 00000BB3 5E                  <1>     pop si
    83 00000BB4 46                  <1>     inc si
    84 00000BB5 EBED                <1>     jmp .dc
    85                              <1> .done:
    86 00000BB7 C3                  <1>     ret
    87                              <1> 
