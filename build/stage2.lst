   128                                  ; ---- the real -> protected mode switch --------------------------------------
   129                                  switch_to_pm:
   130 00000B1A FA                          cli                                  ; real-mode IVT is about to be invalid
   131 00000B1B 0F20C0                      mov eax, cr0
   132 00000B1E 0C01                        or  al, 1                            ; set PE (Protection Enable)
   133 00000B20 0F22C0                      mov cr0, eax
   134 00000B23 EA[280B]0800                jmp CODE_SEG:pm_entry                ; far jump: reload CS=0x08, flush pipeline
   135                                  
   136                                  [bits 32]
   137                                  pm_entry:
   138 00000B28 66B81000                    mov ax, DATA_SEG                     ; reload data selectors (flat data segment)
   139 00000B2C 8ED8                        mov ds, ax
   140 00000B2E 8EC0                        mov es, ax
   141 00000B30 8EE0                        mov fs, ax
   142 00000B32 8EE8                        mov gs, ax
   143 00000B34 8ED0                        mov ss, ax
   144 00000B36 BC00000900                  mov esp, 0x90000                     ; 32-bit stack
   145 00000B3B E9(00000100)                jmp KERNEL_SEG*16                    ; enter the loaded 32-bit kernel at 0x10000
