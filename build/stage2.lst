    78                                  %include "fat12.asm"
     1                              <1> ; FAT12 driver - reads BPB from the resident boot sector at 0x7C00,
     2                              <1> ; finds KERNEL.BIN in the root directory, follows its cluster chain
     3                              <1> ; and loads it to KERNEL_SEG:0000.
     4                              <1> 
     5                              <1> BPB          equ 0x7C00
     6                              <1> bpb_bps      equ BPB+0x0B               ; bytes per sector
     7                              <1> bpb_spc      equ BPB+0x0D               ; sectors per cluster
     8                              <1> bpb_reserved equ BPB+0x0E
     9                              <1> bpb_numfats  equ BPB+0x10
    10                              <1> bpb_rootent  equ BPB+0x11
    11                              <1> bpb_spf      equ BPB+0x16               ; sectors per FAT
    12                              <1> 
    13                              <1> FAT_BUF equ 0x0500                       ; FAT #1 loaded here
