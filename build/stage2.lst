    19 000003E3 E83100              <1>     call parse_config
    20 000003E6 803E[D606]00        <1>     cmp byte [num_entries], 0
    21 000003EB 740F                <1>     je .fallback
    22 000003ED E84001              <1>     call run_menu                     ; sets [find_name] = chosen 8.3 name
    23 000003F0 C706[CA00]0010      <1>     mov word [dest_seg], KERNEL_SEG
