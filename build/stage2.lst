   122                                  %include "gdt.asm"
     1                              <1> ; Global Descriptor Table - flat 32-bit model: null, code, data.
     2                              <1> ; Both code and data span all 4 GB from base 0, so addresses become plain
     3                              <1> ; 32-bit offsets. gdt_install points the CPU at this table (does NOT switch mode).
     4                              <1> 
     5                              <1> gdt_start:
     6                              <1> 
     7                              <1> gdt_null:                        ; entry 0 (selector 0x00) - required, must be zero
     8 00000804 0000000000000000    <1>     dq 0
     9                              <1> 
    10                              <1> gdt_code:                        ; entry 1 (selector 0x08) - ring0 32-bit code
    11 0000080C FFFF                <1>     dw 0xFFFF                    ; limit 15:0
    12 0000080E 0000                <1>     dw 0x0000                    ; base 15:0
    13 00000810 00                  <1>     db 0x00                      ; base 23:16
    14 00000811 9A                  <1>     db 10011010b                 ; access 0x9A: P=1 DPL=0 S=1 E=1 DC=0 RW=1 A=0
    15 00000812 CF                  <1>     db 11001111b                 ; 0xCF: flags G=1 DB=1 L=0 AVL=0 | limit 19:16=0xF
    16 00000813 00                  <1>     db 0x00                      ; base 31:24
    17                              <1> 
    18                              <1> gdt_data:                        ; entry 2 (selector 0x10) - ring0 32-bit data
    19 00000814 FFFF                <1>     dw 0xFFFF
    20 00000816 0000                <1>     dw 0x0000
    21 00000818 00                  <1>     db 0x00
    22 00000819 92                  <1>     db 10010010b                 ; access 0x92: same as code but E=0 (data), RW=1 (writable)
    23 0000081A CF                  <1>     db 11001111b
    24 0000081B 00                  <1>     db 0x00
    25                              <1> 
    26                              <1> gdt_end:
    27                              <1> 
    28                              <1> gdt_descriptor:                  ; the 6-byte operand lgdt reads
    29 0000081C 1700                <1>     dw gdt_end - gdt_start - 1   ; limit = table size - 1
    30 0000081E [04080000]          <1>     dd gdt_start                  ; base = linear address of the table
    31                              <1> 
    32                              <1> CODE_SEG equ gdt_code - gdt_start   ; = 0x08 (offset of code entry = its selector)
    33                              <1> DATA_SEG equ gdt_data - gdt_start   ; = 0x10
    34                              <1> 
    35                              <1> gdt_install:
    36 00000822 0F0116[1C08]        <1>     lgdt [gdt_descriptor]        ; load GDTR with (limit, base)
    37 00000827 C3                  <1>     ret
