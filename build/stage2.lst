   119 00000BF0 46                  <1>     inc si
   120 00000BF1 B008                <1>     mov al, 8                      ; GC8 Bit Mask = glyph byte
   121 00000BF3 BACE03              <1>     mov dx, 0x3CE
   122 00000BF6 EF                  <1>     out dx, ax
   123 00000BF7 89CB                <1>     mov bx, cx
   124 00000BF9 268A11              <1>     mov dl, [es:di+bx]             ; read -> load latches (dummy)
   125 00000BFC 26C601FF            <1>     mov byte [es:di+bx], 0xFF      ; write -> silver where the mask bit is 1
   126 00000C00 41                  <1>     inc cx
   127 00000C01 83F906              <1>     cmp cx, GBYTES
