   124                                  %include "gdt.asm"
     1                              <1> ; Global Descriptor Table - flat 32-bit model: null, code, data.
     2                              <1> ; Both code and data span all 4 GB from base 0, so addresses become plain
     3                              <1> ; 32-bit offsets. gdt_install points the CPU at this table (does NOT switch mode).
     4                              <1> 
     5                              <1> gdt_start:
     6                              <1> 
     7                              <1> gdt_null:                        ; entry 0 (selector 0x00) - required, must be zero
     8 00000808 0000000000000000    <1>     dq 0
     9                              <1> 
    10                              <1> gdt_code:                        ; entry 1 (selector 0x08) - ring0 32-bit code
    11 00000810 FFFF                <1>     dw 0xFFFF                    ; limit 15:0
    12 00000812 0000                <1>     dw 0x0000                    ; base 15:0
    13 00000814 00                  <1>     db 0x00                      ; base 23:16
    14 00000815 9A                  <1>     db 10011010b                 ; access 0x9A: P=1 DPL=0 S=1 E=1 DC=0 RW=1 A=0
    15 00000816 CF                  <1>     db 11001111b                 ; 0xCF: flags G=1 DB=1 L=0 AVL=0 | limit 19:16=0xF
    16 00000817 00                  <1>     db 0x00                      ; base 31:24
    17                              <1> 
    18                              <1> gdt_data:                        ; entry 2 (selector 0x10) - ring0 32-bit data
    19 00000818 FFFF                <1>     dw 0xFFFF
    20 0000081A 0000                <1>     dw 0x0000
    21 0000081C 00                  <1>     db 0x00
    22 0000081D 92                  <1>     db 10010010b                 ; access 0x92: same as code but E=0 (data), RW=1 (writable)
    23 0000081E CF                  <1>     db 11001111b
    24 0000081F 00                  <1>     db 0x00
    25                              <1> 
    26                              <1> gdt_end:
    27                              <1> 
    28                              <1> gdt_descriptor:                  ; the 6-byte operand lgdt reads
    29 00000820 1700                <1>     dw gdt_end - gdt_start - 1   ; limit = table size - 1
    30 00000822 [08080000]          <1>     dd gdt_start                  ; base = linear address of the table
    31                              <1> 
    32                              <1> CODE_SEG equ gdt_code - gdt_start   ; = 0x08 (offset of code entry = its selector)
    33                              <1> DATA_SEG equ gdt_data - gdt_start   ; = 0x10
    34                              <1> 
    35                              <1> gdt_install:
    36 00000826 0F0116[2008]        <1>     lgdt [gdt_descriptor]        ; load GDTR with (limit, base)
    37 0000082B C3                  <1>     ret
   125                                  %include "a20.asm"
     1                              <1> ; A20 gate - unlock addressing above 1 MB before entering protected mode.
     2                              <1> ; Try the BIOS method, fall back to fast-A20 (port 0x92), then verify.
     3                              <1> 
     4                              <1> enable_a20:
     5 0000082C E82500              <1>     call check_a20
     6 0000082F 7512                <1>     jnz .verify                  ; already on (some BIOSes enable it)
     7                              <1> 
     8 00000831 B80124              <1>     mov ax, 0x2401               ; BIOS: enable A20
     9 00000834 CD15                <1>     int 0x15
    10 00000836 E81B00              <1>     call check_a20
    11 00000839 7508                <1>     jnz .verify
    12                              <1> 
    13 0000083B E492                <1>     in al, 0x92                  ; fast A20 via System Control Port A
    14 0000083D 0C02                <1>     or al, 2                     ; bit 1 = A20 enable
    15 0000083F 24FE                <1>     and al, 0xFE                 ; bit 0 = fast reset - keep it clear!
    16 00000841 E692                <1>     out 0x92, al
    17                              <1> 
    18                              <1> .verify:
    19 00000843 E80E00              <1>     call check_a20
    20 00000846 7406                <1>     jz .off
    21 00000848 C606[9308]01        <1>     mov byte [a20_enabled], 1
    22 0000084D C3                  <1>     ret
    23                              <1> .off:
    24 0000084E C606[9308]00        <1>     mov byte [a20_enabled], 0
    25 00000853 C3                  <1>     ret
    26                              <1> 
    27                              <1> ; ZF=0 if A20 enabled, ZF=1 if disabled (0x100500 aliases 0x000500)
    28                              <1> check_a20:
    29 00000854 9C                  <1>     pushf
    30 00000855 1E                  <1>     push ds
    31 00000856 06                  <1>     push es
    32 00000857 57                  <1>     push di
    33 00000858 56                  <1>     push si
    34 00000859 FA                  <1>     cli
    35 0000085A 31C0                <1>     xor ax, ax
    36 0000085C 8EC0                <1>     mov es, ax
    37 0000085E BF0005              <1>     mov di, 0x0500              ; ES:DI = 0000:0500  -> linear 0x00500
    38 00000861 B8FFFF              <1>     mov ax, 0xFFFF
    39 00000864 8ED8                <1>     mov ds, ax
    40 00000866 BE1005              <1>     mov si, 0x0510              ; DS:SI = FFFF:0510  -> linear 0x100500
    41                              <1> 
    42 00000869 268A05              <1>     mov al, [es:di]            ; save originals in AL/AH
    43 0000086C 3E8A24              <1>     mov ah, [ds:si]
    44 0000086F 50                  <1>     push ax
    45                              <1> 
    46 00000870 26C60500            <1>     mov byte [es:di], 0x00     ; write two distinct values
    47 00000874 3EC604FF            <1>     mov byte [ds:si], 0xFF
    48 00000878 26803DFF            <1>     cmp byte [es:di], 0xFF     ; aliased? then [es:di] now reads 0xFF
    49                              <1> 
    50 0000087C 58                  <1>     pop ax                     ; restore originals
    51 0000087D 3E8824              <1>     mov [ds:si], ah
    52 00000880 268805              <1>     mov [es:di], al
    53                              <1> 
    54 00000883 B80000              <1>     mov ax, 0                  ; equal (aliased) -> disabled
    55 00000886 7403                <1>     je .done
    56 00000888 B80100              <1>     mov ax, 1                  ; independent -> enabled
    57                              <1> .done:
    58 0000088B 5E                  <1>     pop si
    59 0000088C 5F                  <1>     pop di
    60 0000088D 07                  <1>     pop es
    61 0000088E 1F                  <1>     pop ds
    62 0000088F 9D                  <1>     popf
    63 00000890 09C0                <1>     or ax, ax                  ; ZF reflects enabled(1)/disabled(0)
    64 00000892 C3                  <1>     ret
    65                              <1> 
    66 00000893 00                  <1> a20_enabled: db 0
   126                                  %include "e820.asm"
     1                              <1> ; E820 - ask BIOS for the physical memory map (int 0x15, EAX=0xE820).
     2                              <1> ; Last BIOS call before protected mode. Stored as a uniform array of 24-byte
     3                              <1> ; entries + a count, for the kernel / Multiboot info to read later.
     4                              <1> 
     5                              <1> MAX_E820 equ 24
     6                              <1> 
     7                              <1> get_e820:
     8 00000894 06                  <1>     push es
     9 00000895 31C0                <1>     xor ax, ax
    10 00000897 8EC0                <1>     mov es, ax                   ; entries live in segment 0
    11 00000899 C706[D808]0000      <1>     mov word [e820_count], 0
    12 0000089F BF[DA08]            <1>     mov di, e820_map             ; ES:DI = first slot
    13 000008A2 6631DB              <1>     xor ebx, ebx                 ; continuation = 0 (first call)
    14                              <1> .loop:
    15 000008A5 66B820E80000        <1>     mov eax, 0xE820
    16 000008AB 66BA50414D53        <1>     mov edx, 0x534D4150          ; 'SMAP' - must be re-set every call
    17 000008B1 66B918000000        <1>     mov ecx, 24                  ; entry buffer size
    18 000008B7 CD15                <1>     int 0x15
    19 000008B9 721B                <1>     jc .done                     ; CF = error, or list finished
    20 000008BB 663D50414D53        <1>     cmp eax, 0x534D4150          ; BIOS must echo 'SMAP'
    21 000008C1 7513                <1>     jne .done
    22 000008C3 FF06[D808]          <1>     inc word [e820_count]
    23 000008C7 83C718              <1>     add di, 24                   ; next slot (uniform stride)
    24 000008CA 6685DB              <1>     test ebx, ebx                ; continuation 0 = that was the last entry
    25 000008CD 7407                <1>     jz .done
    26 000008CF 833E[D808]18        <1>     cmp word [e820_count], MAX_E820
    27 000008D4 72CF                <1>     jb .loop
    28                              <1> .done:
    29 000008D6 07                  <1>     pop es
    30 000008D7 C3                  <1>     ret
    31                              <1> 
    32 000008D8 0000                <1> e820_count: dw 0
    33 000008DA 00<rep 240h>        <1> e820_map:   times MAX_E820*24 db 0
