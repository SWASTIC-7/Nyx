   130                                  ; ---- the real -> protected mode switch --------------------------------------
   131                                  switch_to_pm:
   132 00000EDE FA                          cli                                  ; real-mode IVT is about to be invalid
   133 00000EDF 0F20C0                      mov eax, cr0
   134 00000EE2 0C01                        or  al, 1                            ; set PE (Protection Enable)
   135 00000EE4 0F22C0                      mov cr0, eax
   136 00000EE7 EA[EC0E]0800                jmp CODE_SEG:pm_entry                ; far jump: reload CS=0x08, flush pipeline
   137                                  
   138                                  [bits 32]
   139                                  pm_entry:
   140 00000EEC 66B81000                    mov ax, DATA_SEG                     ; reload data selectors (flat data segment)
   141 00000EF0 8ED8                        mov ds, ax
   142 00000EF2 8EC0                        mov es, ax
   143 00000EF4 8EE0                        mov fs, ax
   144 00000EF6 8EE8                        mov gs, ax
   145 00000EF8 8ED0                        mov ss, ax
   146 00000EFA BC00000900                  mov esp, 0x90000                     ; 32-bit stack
   147                                  
   148 00000EFF BE00000100                  mov esi, KERNEL_SEG*16               ; scan the loaded kernel for the Multiboot header
   149 00000F04 8B0D[CD000000]              mov ecx, [file_size]
   150 00000F0A C1E902                      shr ecx, 2                           ; dwords
   151 00000F0D 81F900080000                cmp ecx, 2048                        ; ...within the first 8 KB
   152 00000F13 7605                        jbe .have_len
   153 00000F15 B900080000                  mov ecx, 2048
   154                                  .have_len:
   155                                  .scan:
   156 00000F1A 813E02B0AD1B                cmp dword [esi], 0x1BADB002
   157 00000F20 740B                        je .multiboot
   158 00000F22 83C604                      add esi, 4
   159 00000F25 49                          dec ecx
   160 00000F26 75F2                        jnz .scan
   161 00000F28 E9(00000100)                jmp KERNEL_SEG*16                    ; no header -> plain binary kernel (our C kernel)
   162                                  
   163                                  .multiboot:
   164 00000F2D E80F000000                  call build_mb_info
   165 00000F32 B802B0AD2B                  mov eax, 0x2BADB002                  ; the handoff magic
   166 00000F37 BB[DC0F0000]                mov ebx, mb_info                     ; -> the info structure
   167 00000F3C E9(00000100)                jmp KERNEL_SEG*16
   168                                  
   169                                  ; turn the E820 map into a Multiboot info struct + mmap
   170                                  build_mb_info:
   171 00000F41 BE[F2080000]                mov esi, e820_map
   172 00000F46 BF[36100000]                mov edi, mb_mmap
   173 00000F4B 0FB70D[F0080000]            movzx ecx, word [e820_count]
   174                                  .mm:
   175 00000F52 C70714000000                mov dword [edi], 20                  ; size (entry bytes excluding this field)
   176 00000F58 8B06                        mov eax, [esi];    mov [edi+4],  eax ; base low
   177 00000F5A 8B4604                      mov eax, [esi+4];  mov [edi+8],  eax ; base high
   178 00000F5D 8B4608                      mov eax, [esi+8];  mov [edi+12], eax ; length low
   179 00000F60 8B460C                      mov eax, [esi+12]; mov [edi+16], eax ; length high
   180 00000F63 8B4610                      mov eax, [esi+16]; mov [edi+20], eax ; type
   181 00000F66 83C618                      add esi, 24
   182 00000F69 83C718                      add edi, 24
   183 00000F6C 49                          dec ecx
   184 00000F6D 75E3                        jnz .mm
   185                                  
   186 00000F6F 0FB705[F0080000]            movzx eax, word [e820_count]
   187 00000F76 6BC018                      imul eax, eax, 24
   188 00000F79 A3[08100000]                mov [mb_info+44], eax                ; mmap_length
   189 00000F7E C705[0C100000]-             mov dword [mb_info+48], mb_mmap      ; mmap_addr
   189 00000F84 [36100000]         
   190 00000F88 C705[DC0F0000]4100-         mov dword [mb_info], 0x41            ; flags: mem (bit0) + mmap (bit6)
   190 00000F90 0000               
   191 00000F92 C705[E00F0000]8002-         mov dword [mb_info+4], 640           ; mem_lower (KB)
   191 00000F9A 0000               
   192                                  
   193 00000F9C C705[E40F0000]0000-         mov dword [mb_info+8], 0             ; mem_upper = usable RAM at 1 MB, in KB
   193 00000FA4 0000               
   194 00000FA6 BE[F2080000]                mov esi, e820_map
   195 00000FAB 0FB70D[F0080000]            movzx ecx, word [e820_count]
   196                                  .mu:
   197 00000FB2 813E00001000                cmp dword [esi], 0x00100000
   198 00000FB8 7519                        jne .mu_next
   199 00000FBA 837E0400                    cmp dword [esi+4], 0
   200 00000FBE 7513                        jne .mu_next
   201 00000FC0 837E1001                    cmp dword [esi+16], 1
   202 00000FC4 750D                        jne .mu_next
   203 00000FC6 8B4608                      mov eax, [esi+8]
   204 00000FC9 C1E80A                      shr eax, 10
   205 00000FCC A3[E40F0000]                mov [mb_info+8], eax
   206 00000FD1 EB06                        jmp .mu_done
   207                                  .mu_next:
   208 00000FD3 83C618                      add esi, 24
   209 00000FD6 49                          dec ecx
   210 00000FD7 75D9                        jnz .mu
   211                                  .mu_done:
   212 00000FD9 C3                          ret
