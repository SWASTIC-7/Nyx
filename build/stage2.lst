   129 00000C06 5F                  <1>     pop di
   130 00000C07 83C750              <1>     add di, SCR_BYTES              ; next scanline
   131 00000C0A 4D                  <1>     dec bp
   132 00000C0B 75DE                <1>     jnz .row
   133                              <1> .skip:
   134 00000C0D 5E                  <1>     pop si
   135 00000C0E C3                  <1>     ret
