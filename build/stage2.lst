    32 000000F0 31D2                <1>     xor dx, dx
    33 000000F2 F7360B7C            <1>     div word [bpb_bps]                   ; ceil(dir bytes / bytes_per_sector)
    34 000000F6 A3[B401]            <1>     mov [root_sectors], ax
    35                              <1> 
    36 000000F9 0306[B201]          <1>     add ax, [root_start]
