   137                              <1> splash_line:                        ; silver underline spanning the word
   138 00000C0F B800A0              <1>     mov ax, VGA_SEG
   139 00000C12 8EC0                <1>     mov es, ax
   140 00000C14 BACE03              <1>     mov dx, 0x3CE
   141 00000C17 B808FF              <1>     mov ax, 0xFF08                 ; full-byte writes
