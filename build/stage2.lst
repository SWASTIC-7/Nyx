    45                              <1> 
    46 00000111 A1[B201]            <1>     mov ax, [root_start]
    47 00000114 8B0E[B401]          <1>     mov cx, [root_sectors]
    48 00000118 BB0020              <1>     mov bx, DIR_BUF
