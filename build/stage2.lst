   125                                  %include "gdt.asm"
     1                              <1> ; Global Descriptor Table - flat 32-bit model: null, code, data.
     2                              <1> ; Both code and data span all 4 GB from base 0, so addresses become plain
     3                              <1> ; 32-bit offsets. gdt_install points the CPU at this table (does NOT switch mode).
     4                              <1> 
     5                              <1> gdt_start:
     6                              <1> 
     7                              <1> gdt_null:                        ; entry 0 (selector 0x00) - required, must be zero
     8 00000820 0000000000000000    <1>     dq 0
     9                              <1> 
    10                              <1> gdt_code:                        ; entry 1 (selector 0x08) - ring0 32-bit code
    11 00000828 FFFF                <1>     dw 0xFFFF                    ; limit 15:0
    12 0000082A 0000                <1>     dw 0x0000                    ; base 15:0
    13 0000082C 00                  <1>     db 0x00                      ; base 23:16
    14 0000082D 9A                  <1>     db 10011010b                 ; access 0x9A: P=1 DPL=0 S=1 E=1 DC=0 RW=1 A=0
    15 0000082E CF                  <1>     db 11001111b                 ; 0xCF: flags G=1 DB=1 L=0 AVL=0 | limit 19:16=0xF
    16 0000082F 00                  <1>     db 0x00                      ; base 31:24
    17                              <1> 
    18                              <1> gdt_data:                        ; entry 2 (selector 0x10) - ring0 32-bit data
    19 00000830 FFFF                <1>     dw 0xFFFF
    20 00000832 0000                <1>     dw 0x0000
    21 00000834 00                  <1>     db 0x00
    22 00000835 92                  <1>     db 10010010b                 ; access 0x92: same as code but E=0 (data), RW=1 (writable)
    23 00000836 CF                  <1>     db 11001111b
    24 00000837 00                  <1>     db 0x00
    25                              <1> 
    26                              <1> gdt_end:
    27                              <1> 
    28                              <1> gdt_descriptor:                  ; the 6-byte operand lgdt reads
    29 00000838 1700                <1>     dw gdt_end - gdt_start - 1   ; limit = table size - 1
    30 0000083A [20080000]          <1>     dd gdt_start                  ; base = linear address of the table
    31                              <1> 
    32                              <1> CODE_SEG equ gdt_code - gdt_start   ; = 0x08 (offset of code entry = its selector)
    33                              <1> DATA_SEG equ gdt_data - gdt_start   ; = 0x10
    34                              <1> 
    35                              <1> gdt_install:
    36 0000083E 0F0116[3808]        <1>     lgdt [gdt_descriptor]        ; load GDTR with (limit, base)
    37 00000843 C3                  <1>     ret
   126                                  %include "a20.asm"
     1                              <1> ; A20 gate - unlock addressing above 1 MB before entering protected mode.
     2                              <1> ; Try the BIOS method, fall back to fast-A20 (port 0x92), then verify.
     3                              <1> 
     4                              <1> enable_a20:
     5 00000844 E82500              <1>     call check_a20
     6 00000847 7512                <1>     jnz .verify                  ; already on (some BIOSes enable it)
     7                              <1> 
     8 00000849 B80124              <1>     mov ax, 0x2401               ; BIOS: enable A20
     9 0000084C CD15                <1>     int 0x15
    10 0000084E E81B00              <1>     call check_a20
    11 00000851 7508                <1>     jnz .verify
    12                              <1> 
    13 00000853 E492                <1>     in al, 0x92                  ; fast A20 via System Control Port A
    14 00000855 0C02                <1>     or al, 2                     ; bit 1 = A20 enable
    15 00000857 24FE                <1>     and al, 0xFE                 ; bit 0 = fast reset - keep it clear!
    16 00000859 E692                <1>     out 0x92, al
    17                              <1> 
    18                              <1> .verify:
    19 0000085B E80E00              <1>     call check_a20
    20 0000085E 7406                <1>     jz .off
    21 00000860 C606[AB08]01        <1>     mov byte [a20_enabled], 1
    22 00000865 C3                  <1>     ret
    23                              <1> .off:
    24 00000866 C606[AB08]00        <1>     mov byte [a20_enabled], 0
    25 0000086B C3                  <1>     ret
    26                              <1> 
    27                              <1> ; ZF=0 if A20 enabled, ZF=1 if disabled (0x100500 aliases 0x000500)
    28                              <1> check_a20:
    29 0000086C 9C                  <1>     pushf
    30 0000086D 1E                  <1>     push ds
    31 0000086E 06                  <1>     push es
    32 0000086F 57                  <1>     push di
    33 00000870 56                  <1>     push si
    34 00000871 FA                  <1>     cli
    35 00000872 31C0                <1>     xor ax, ax
    36 00000874 8EC0                <1>     mov es, ax
    37 00000876 BF0005              <1>     mov di, 0x0500              ; ES:DI = 0000:0500  -> linear 0x00500
    38 00000879 B8FFFF              <1>     mov ax, 0xFFFF
    39 0000087C 8ED8                <1>     mov ds, ax
    40 0000087E BE1005              <1>     mov si, 0x0510              ; DS:SI = FFFF:0510  -> linear 0x100500
    41                              <1> 
    42 00000881 268A05              <1>     mov al, [es:di]            ; save originals in AL/AH
    43 00000884 3E8A24              <1>     mov ah, [ds:si]
    44 00000887 50                  <1>     push ax
    45                              <1> 
    46 00000888 26C60500            <1>     mov byte [es:di], 0x00     ; write two distinct values
    47 0000088C 3EC604FF            <1>     mov byte [ds:si], 0xFF
    48 00000890 26803DFF            <1>     cmp byte [es:di], 0xFF     ; aliased? then [es:di] now reads 0xFF
    49                              <1> 
    50 00000894 58                  <1>     pop ax                     ; restore originals
    51 00000895 3E8824              <1>     mov [ds:si], ah
    52 00000898 268805              <1>     mov [es:di], al
    53                              <1> 
    54 0000089B B80000              <1>     mov ax, 0                  ; equal (aliased) -> disabled
    55 0000089E 7403                <1>     je .done
    56 000008A0 B80100              <1>     mov ax, 1                  ; independent -> enabled
    57                              <1> .done:
    58 000008A3 5E                  <1>     pop si
    59 000008A4 5F                  <1>     pop di
    60 000008A5 07                  <1>     pop es
    61 000008A6 1F                  <1>     pop ds
    62 000008A7 9D                  <1>     popf
    63 000008A8 09C0                <1>     or ax, ax                  ; ZF reflects enabled(1)/disabled(0)
    64 000008AA C3                  <1>     ret
    65                              <1> 
    66 000008AB 00                  <1> a20_enabled: db 0
   127                                  %include "e820.asm"
     1                              <1> ; E820 - ask BIOS for the physical memory map (int 0x15, EAX=0xE820).
     2                              <1> ; Last BIOS call before protected mode. Stored as a uniform array of 24-byte
     3                              <1> ; entries + a count, for the kernel / Multiboot info to read later.
     4                              <1> 
     5                              <1> MAX_E820 equ 24
     6                              <1> 
     7                              <1> get_e820:
     8 000008AC 06                  <1>     push es
     9 000008AD 31C0                <1>     xor ax, ax
    10 000008AF 8EC0                <1>     mov es, ax                   ; entries live in segment 0
    11 000008B1 C706[F008]0000      <1>     mov word [e820_count], 0
    12 000008B7 BF[F208]            <1>     mov di, e820_map             ; ES:DI = first slot
    13 000008BA 6631DB              <1>     xor ebx, ebx                 ; continuation = 0 (first call)
    14                              <1> .loop:
    15 000008BD 66B820E80000        <1>     mov eax, 0xE820
    16 000008C3 66BA50414D53        <1>     mov edx, 0x534D4150          ; 'SMAP' - must be re-set every call
    17 000008C9 66B918000000        <1>     mov ecx, 24                  ; entry buffer size
    18 000008CF CD15                <1>     int 0x15
    19 000008D1 721B                <1>     jc .done                     ; CF = error, or list finished
    20 000008D3 663D50414D53        <1>     cmp eax, 0x534D4150          ; BIOS must echo 'SMAP'
    21 000008D9 7513                <1>     jne .done
    22 000008DB FF06[F008]          <1>     inc word [e820_count]
    23 000008DF 83C718              <1>     add di, 24                   ; next slot (uniform stride)
    24 000008E2 6685DB              <1>     test ebx, ebx                ; continuation 0 = that was the last entry
    25 000008E5 7407                <1>     jz .done
    26 000008E7 833E[F008]18        <1>     cmp word [e820_count], MAX_E820
    27 000008EC 72CF                <1>     jb .loop
    28                              <1> .done:
    29 000008EE 07                  <1>     pop es
    30 000008EF C3                  <1>     ret
    31                              <1> 
    32 000008F0 0000                <1> e820_count: dw 0
    33 000008F2 00<rep 240h>        <1> e820_map:   times MAX_E820*24 db 0
   128                                  %include "splash.asm"
     1                              <1> ; VGA mode 13h boot splash - draws the SELECTED kernel's name (NyxOS / NyxOS2)
     2                              <1> ; as a large brushed-silver wordmark on black. Letters are hand-designed 24x32
     3                              <1> ; glyphs (glyphs.inc) drawn at native resolution -> crisp, no scaling artifacts.
     4                              <1> ; Real mode; shown after the menu selection, before the protected-mode switch.
     5                              <1> 
     6                              <1> VGA_SEG  equ 0xA000
     7                              <1> LOGO_Y   equ 84                    ; top scanline of the wordmark
     8                              <1> GLYPH_H  equ 32
     9                              <1> GLYPH_SZ equ GLYPH_H*3             ; 96 bytes per glyph (3 bytes/row)
    10                              <1> ADVANCE  equ 26                    ; glyph pitch (24 wide + 2 gap)
    11                              <1> 
    12                              <1> splash:
    13 00000B32 B81300              <1>     mov ax, 0x0013                 ; mode 13h (320x200x256)
    14 00000B35 CD10                <1>     int 0x10
