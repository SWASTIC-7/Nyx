    19 00000B43 E8FF00              <1>     call splash_hold
    20 00000B46 B80300              <1>     mov ax, 0x0003                 ; restore text mode
    21 00000B49 CD10                <1>     int 0x10
    22 00000B4B C3                  <1>     ret
    23                              <1> 
    24                              <1> splash_palette:
    25 00000B4C B000                <1>     mov al, 0                      ; index 0 = black
    26 00000B4E BAC803              <1>     mov dx, 0x3C8
    27 00000B51 EE                  <1>     out dx, al
    28 00000B52 BAC903              <1>     mov dx, 0x3C9
    29 00000B55 30C0                <1>     xor al, al
    30 00000B57 EE                  <1>     out dx, al
    31 00000B58 EE                  <1>     out dx, al
    32 00000B59 EE                  <1>     out dx, al
    33 00000B5A B080                <1>     mov al, 128                    ; 128..135 = metallic silver gradient
    34 00000B5C BAC803              <1>     mov dx, 0x3C8
    35 00000B5F EE                  <1>     out dx, al
    36 00000B60 BAC903              <1>     mov dx, 0x3C9
    37 00000B63 BE[5A0C]            <1>     mov si, metal_pal
    38 00000B66 B91800              <1>     mov cx, 24
