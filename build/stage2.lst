    21 000003E9 740F                <1>     je .fallback
    22 000003EB E84001              <1>     call run_menu                     ; sets [find_name] = chosen 8.3 name
    23 000003EE C706[C800]0010      <1>     mov word [dest_seg], KERNEL_SEG
    24 000003F4 E86EFC              <1>     call fat_load_file
    25 000003F7 7213                <1>     jc .err
    26 000003F9 C3                  <1>     ret
    27                              <1> .fallback:
