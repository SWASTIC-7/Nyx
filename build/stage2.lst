    89                              <1> draw_glyph:
    90 00000BB8 56                  <1>     push si
    91 00000BB9 BE[650C]            <1>     mov si, glyph_chars
    92 00000BBC 31DB                <1>     xor bx, bx
    93                              <1> .find:
