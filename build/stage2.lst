   100 00000BC9 EBF3                <1>     jmp .find
   101                              <1> .got:
   102 00000BCB B88001              <1>     mov ax, GLYPH_SZ
   103 00000BCE F7E3                <1>     mul bx
   104 00000BD0 BE[6B0C]            <1>     mov si, glyph_data
   105 00000BD3 01C6                <1>     add si, ax                     ; si -> glyph's rows (GBYTES bytes each)
   106 00000BD5 B8D000              <1>     mov ax, LOGO_Y                 ; di = top-left screen byte
   107 00000BD8 BB5000              <1>     mov bx, SCR_BYTES
   108 00000BDB F7E3                <1>     mul bx
   109 00000BDD 8B1E[630C]          <1>     mov bx, [cur_x]
   110 00000BE1 C1EB03              <1>     shr bx, 3                      ; pixel x -> byte column
   111 00000BE4 01D8                <1>     add ax, bx
   112 00000BE6 89C7                <1>     mov di, ax
   113 00000BE8 BD4000              <1>     mov bp, GLYPH_H
   114                              <1> .row:
   115 00000BEB 57                  <1>     push di
   116 00000BEC 31C9                <1>     xor cx, cx                     ; byte 0..GBYTES-1
   117                              <1> .byte:
