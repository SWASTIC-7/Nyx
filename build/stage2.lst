    21 000003E8 740F                <1>     je .fallback
    22 000003EA E84001              <1>     call run_menu                     ; sets [find_name] = chosen 8.3 name
    23 000003ED C706[C700]0010      <1>     mov word [dest_seg], KERNEL_SEG
    24 000003F3 E86EFC              <1>     call fat_load_file
    25 000003F6 7213                <1>     jc .err
    26 000003F8 C3                  <1>     ret
    27                              <1> .fallback:
