   120                                  %include "menu.asm"
     1                              <1> ; Boot menu (real mode). Reads NYX.CFG from the FAT volume, parses timeout/
     2                              <1> ; default/entries, draws a text-mode menu, and lets the user pick with the
     3                              <1> ; arrow keys (int 0x16) or auto-boots the default after a countdown.
     4                              <1> ; Config format (one field per line):
     5                              <1> ;   <timeout seconds>
     6                              <1> ;   <default index>
     7                              <1> ;   <Label> <FILENAME.EXT>
     8                              <1> ;   ...
     9                              <1> 
    10                              <1> CFG_BUF     equ 0x4000               ; linear address the config text loads to
    11                              <1> MAX_ENTRIES equ 8
    12                              <1> 
    13                              <1> ; try NYX.CFG -> menu -> load choice; if no config, fall back to KERNEL.BIN
    14                              <1> menu_main:
    15 000003C9 C706[BF00][BE06]    <1>     mov word [find_name], cfg_name
    16 000003CF C706[C100]0004      <1>     mov word [dest_seg], CFG_SEG
    17 000003D5 E886FC              <1>     call fat_load_file
    18 000003D8 7219                <1>     jc .fallback
    19 000003DA E83100              <1>     call parse_config
    20 000003DD 803E[CD06]00        <1>     cmp byte [num_entries], 0
    21 000003E2 740F                <1>     je .fallback
    22 000003E4 E84001              <1>     call run_menu                     ; sets [find_name] = chosen 8.3 name
    23 000003E7 C706[C100]0010      <1>     mov word [dest_seg], KERNEL_SEG
    24 000003ED E86EFC              <1>     call fat_load_file
    25 000003F0 7213                <1>     jc .err
    26 000003F2 C3                  <1>     ret
    27                              <1> .fallback:
    28 000003F3 C706[BF00][C301]    <1>     mov word [find_name], kernel_name
    29 000003F9 C706[C100]0010      <1>     mov word [dest_seg], KERNEL_SEG
    30 000003FF E85CFC              <1>     call fat_load_file
    31 00000402 7201                <1>     jc .err
    32 00000404 C3                  <1>     ret
    33                              <1> .err:
    34 00000405 BE[F407]            <1>     mov si, msg_loaderr
    35 00000408 E88AFC              <1>     call print_string
